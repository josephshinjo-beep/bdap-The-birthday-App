# Copy to .env.local. With the two Supabase values empty the app runs on mock data.

# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (Vercel env vars). Never prefix with NEXT_PUBLIC_, never paste in chat.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for POST /api/cron/reminders (also stored in Supabase Vault, see supabase/cron.sql)
CRON_SECRET=

# Public URL, e.g. https://bdap.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: force mock data even when Supabase is configured
# NEXT_PUBLIC_DATA_MODE=mock
